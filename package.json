{
  "name": "@zzx0220/dsh-watchlist",
  "version": "0.8.0",
  "description": "Follow-list for DeepSeek Harness: keep the topics you care about, run scheduled web searches for progress, record digests, and push summaries where you want them.",
  "license": "MIT",
  "author": "zzx0220",
  "homepage": "https://github.com/zzx0220/dsh-watchlist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzx0220/dsh-watchlist.git"
  },
  "bugs": {
    "url": "https://github.com/zzx0220/dsh-watchlist/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "watchlist",
    "digest",
    "scheduled-search",
    "research-tracking"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/smoke.mjs && node scripts/client-check.mjs"
  }
}
