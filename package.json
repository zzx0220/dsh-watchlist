{
  "name": "dsh-watchlist",
  "version": "0.5.8",
  "description": "Follow-list for DeepSeek Harness: keep the topics you care about, run scheduled web searches for progress, record digests, and push summaries where you want them.",
  "license": "MIT",
  "author": "zzx0220",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "watchlist",
    "digest",
    "scheduled-search",
    "research-tracking"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs"
  }
}
